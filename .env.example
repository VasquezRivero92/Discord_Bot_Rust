DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Igual que en Node, byte a byte: se usa tal cual (los espacios de los bordes cuentan).
ADMIN_JWT_SECRET=
ADMIN_ROLE_ID=
BASE_URL=
NODE_ENV=
PORT=
LEGACY_URL=
STEAM_BOT_URL=
STATIC_DIR=
CORS_ORIGINS=
CS2_SERVER_PUBLIC_IP=
MIXTON_SERVER_IP=

# Solo "1" si el origen es alcanzable UNICAMENTE por el tunel de Cloudflare.
TRUST_CF_CONNECTING_IP=
# Por defecto vacio (no): el legado confia en un solo salto (trust proxy 1).
PROXY_APPEND_PEER_TO_XFF=
# Guardas de tiempo del proxy, en segundos enteros. Vacio o 0 = desactivada (por defecto).
# Tope hasta la cabecera de respuesta de Node: 504 JSON al vencer (no aplica a
# WebSocket ni a las rutas exentas: SSE y arranque/apagado del servidor CS2, ver
# runbook). Punto de partida tras el corte: 90; menos de 2 no tiene sentido.
PROXY_FIRST_BYTE_TIMEOUT_SECS=
# Cierra un WebSocket proxificado sin ningun frame en ninguna direccion. Punto de partida: 3600.
WS_IDLE_TIMEOUT_SECS=

# Firestore (GET /api/reclamaciones/:code y lecturas del panel de la fase 2A). Sin
# FIRESTORE_PROJECT_ID queda desactivado y esas rutas siguen en Node. Con proyecto hace falta UNA fuente
# explicita (si no, el arranque falla con codigo 2):
#   FIRESTORE_EMULATOR_HOST       emulador (gana sobre las demas)
#   FIREBASE_SERVICE_ACCOUNT_PATH clave de cuenta de servicio (ruta, nunca el contenido)
#   FIRESTORE_USE_ADC=1           Application Default Credentials (opt-in explicito)
# Base de datos MySQL en tiempo real (CDC / Pub-Sub nativo, prioridad principal):
DATABASE_URL=mysql://root:password@127.0.0.1:3306/machupeek
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=machupeek

FIRESTORE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_USE_ADC=

# Docker compose (docker-compose.yml): build de public/ del legado, montado en solo lectura.
LEGACY_PUBLIC_DIR=
# TUNNEL_TOKEN NO va aqui: compose pasa este archivo entero al contenedor web.
# Exportalo en la shell al lanzar compose (ver docs/runbook-corte.md). Compose falla si falta
# TUNNEL_TOKEN o MYSQL_ROOT_PASSWORD: ya no hay valores por defecto.

# Secreto compartido con MatchZy. Sin el, /api/matchzy/event rechaza TODO evento (401).
# En el servidor CS2 (cfg de MatchZy):
#   matchzy_remote_log_header_key "Authorization"
#   matchzy_remote_log_header_value "Bearer <este secreto>"
# Genera uno largo, p. ej.: openssl rand -hex 32
MATCHZY_WEBHOOK_SECRET=
# Pago automatico de premios al terminar la serie (solo "1" lo activa).
MATCH_PAYOUT_ENABLED=
# Webhook de Discord para anuncios del Mixton (secreto; vacio = se busca con el token del bot).
DISCORD_MIXTON_WEBHOOK_URL=
# Canal de Discord (id numerico) para alertas de billetera: retiros en revision, saldos que no
# cuadran con el libro de movimientos, etc. Vacio = solo quedan en el log.
WALLET_ALERTS_CHANNEL_ID=

# Usuarios de MySQL por servicio (minimo privilegio). Pasos, una sola vez en una base existente:
#   1) definir WEB_DB_PASSWORD y YAPE_DB_PASSWORD;
#   2) docker exec -e WEB_DB_PASSWORD -e YAPE_DB_PASSWORD machupeek-mysql \
#        sh /docker-entrypoint-initdb.d/02-service-users.sh
#   3) definir WEB_DB_USER=machupeek_web y YAPE_DB_USER=machupeek_yape y reiniciar compose.
# Vacios = los servicios siguen entrando como root.
WEB_DB_USER=
WEB_DB_PASSWORD=
YAPE_DB_USER=
YAPE_DB_PASSWORD=

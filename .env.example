DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Igual que en Node, byte a byte: se usa tal cual (los espacios de los bordes cuentan).
ADMIN_JWT_SECRET=
ADMIN_ROLE_ID=
BASE_URL=
NODE_ENV=
PORT=
LEGACY_URL=
STEAM_BOT_URL=
STATIC_DIR=
CORS_ORIGINS=
CS2_SERVER_PUBLIC_IP=
MIXTON_SERVER_IP=

# Solo "1" si el origen es alcanzable UNICAMENTE por el tunel de Cloudflare.
TRUST_CF_CONNECTING_IP=
# Por defecto vacio (no): el legado confia en un solo salto (trust proxy 1).
PROXY_APPEND_PEER_TO_XFF=
# Guardas de tiempo del proxy, en segundos enteros. Vacio o 0 = desactivada (por defecto).
# Tope hasta la cabecera de respuesta de Node: 504 JSON al vencer (no aplica a
# WebSocket ni a las rutas exentas: SSE y arranque/apagado del servidor CS2, ver
# runbook). Punto de partida tras el corte: 90; menos de 2 no tiene sentido.
PROXY_FIRST_BYTE_TIMEOUT_SECS=
# Cierra un WebSocket proxificado sin ningun frame en ninguna direccion. Punto de partida: 3600.
WS_IDLE_TIMEOUT_SECS=

# Firestore (GET /api/reclamaciones/:code y lecturas del panel de la fase 2A). Sin
# FIRESTORE_PROJECT_ID queda desactivado y esas rutas siguen en Node. Con proyecto hace falta UNA fuente
# explicita (si no, el arranque falla con codigo 2):
#   FIRESTORE_EMULATOR_HOST       emulador (gana sobre las demas)
#   FIREBASE_SERVICE_ACCOUNT_PATH clave de cuenta de servicio (ruta, nunca el contenido)
#   FIRESTORE_USE_ADC=1           Application Default Credentials (opt-in explicito)
FIRESTORE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_USE_ADC=

# Docker compose (docker-compose.yml): build de public/ del legado, montado en solo lectura.
LEGACY_PUBLIC_DIR=
# El token del tunel NO va aqui: compose pasa este archivo entero al contenedor web.
# Se guarda en secrets/tunnel-token (ignorado por git; ver docs/despliegue-docker.md).

# ---------------------------------------------------------------- Faceit
FACEIT_API_KEY=
FACEIT_HUB_ID=
FACEIT_CLUB_ID=
FACEIT_LEADERBOARD_ID=
FACEIT_QUEUE_IDS=
FACEIT_HUB_ROLE_ID=

# ---------------------------------------------------------------- Discord (canales y roles)
ADMIN_ROLE_NAME=
DISCORD_HUB_ROLE_ID=
DISCORD_MATCH_ACCESS_ROLE_ID=
DISCORD_LINK_CHANNEL_ID=
DISCORD_MATCHES_CHANNEL_ID=
DISCORD_WAITING_ROOM_CHANNEL_ID=
DISCORD_MIXTON_CHANNEL_ID=
DISCORD_MIXTON_CHAT_CHANNEL_ID=
DISCORD_ADMIN_ALERTS_CHANNEL_ID=
DISCORD_SUPPORT_CHANNEL_ID=
DISCORD_RECHARGE_CHANNEL_ID=
DISCORD_ROLES_CHANNEL_ID=
DISCORD_SANCTIONS_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_MUSIC_CHANNEL_ID=

# ---------------------------------------------------------------- Servidor CS2 (AWS EC2 + SSH)
CS2_SERVER_IP=
CS2_SSH_USER=
# compose fija CS2_SSH_KEY_PATH=/app/clave_cs2.pem (clave montada en solo lectura).
AWS_REGION=
AWS_EC2_INSTANCE_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Apuestas con saldo
# Secreto compartido con el servidor CS2 para cerrar partidas (x-cs2-secret). DEJARLO VACIO
# mantiene las apuestas DESACTIVADAS (las partidas sin apuesta funcionan igual). Definirlo ACTIVA
# el cobro de apuestas al lanzar: antes hay que configurar el plugin MatchZy del servidor CS2 para
# que envie esta misma cabecera en sus eventos (ver docs/despliegue-docker.md). Si no, las partidas
# con apuesta no se cerrarian y la cuota quedaria retenida.
CS2_API_SECRET=

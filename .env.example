DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ADMIN_JWT_SECRET=
ADMIN_ROLE_ID=
BASE_URL=
NODE_ENV=
PORT=
LEGACY_URL=
STEAM_BOT_URL=
STATIC_DIR=
CORS_ORIGINS=
FACEIT_API_KEY=
FACEIT_HUB_ID=
CS2_SERVER_PUBLIC_IP=
MIXTON_SERVER_IP=
STEAM_BOT_API_KEY=

# Solo "1" si el origen es alcanzable UNICAMENTE por el tunel de Cloudflare.
TRUST_CF_CONNECTING_IP=
# Por defecto vacio (no): el legado confia en un solo salto (trust proxy 1).
PROXY_APPEND_PEER_TO_XFF=

# Firestore (solo GET /api/reclamaciones/:code). Sin FIRESTORE_PROJECT_ID queda
# desactivado y esa ruta sigue en Node. Con proyecto hace falta UNA fuente
# explicita (si no, el arranque falla con codigo 2):
#   FIRESTORE_EMULATOR_HOST       emulador (gana sobre las demas)
#   FIREBASE_SERVICE_ACCOUNT_PATH clave de cuenta de servicio (ruta, nunca el contenido)
#   FIRESTORE_USE_ADC=1           Application Default Credentials (opt-in explicito)
FIRESTORE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_USE_ADC=

# Docker compose (docker-compose.yml): build de public/ del legado, montado en solo lectura.
LEGACY_PUBLIC_DIR=
# TUNNEL_TOKEN NO va aqui: compose pasa este archivo entero al contenedor web.
# Exportalo en la shell al lanzar compose (ver docs/runbook-corte.md).
